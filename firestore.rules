rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Reusable Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedSignedIn() && request.auth.token.email == 'ahmad.almoustafah@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isVerifiedSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isVerifiedSignedIn() && request.auth.uid == uid;
    }

    function isDocOwner(ownerUid) {
      return isVerifiedSignedIn() && request.auth.uid == ownerUid;
    }

    // --- Validation Blueprints ---
    function isValidSubscription(data, subscriptionId) {
      return data.keys().hasAll([
        'id',
        'ownerUid',
        'fullName',
        'status',
        'adminMessage',
        'adminMessageUpdatedAt',
        'filesCount',
        'clientCreatedAt',
        'createdAt',
        'lastSeenAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerUid',
        'fullName',
        'status',
        'adminMessage',
        'adminMessageUpdatedAt',
        'filesCount',
        'clientCreatedAt',
        'createdAt',
        'lastSeenAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.id == subscriptionId &&
      isValidId(data.ownerUid) &&
      data.fullName is string &&
      data.fullName.size() >= 1 &&
      data.fullName.size() <= 150 &&
      data.status is string &&
      data.status.size() >= 1 &&
      data.status.size() <= 20 &&
      (data.status == 'active' || data.status == 'suspended') &&
      data.adminMessage is string &&
      data.adminMessage.size() <= 2000 &&
      data.adminMessageUpdatedAt is string &&
      data.adminMessageUpdatedAt.size() <= 64 &&
      data.filesCount is int &&
      data.filesCount >= 0 &&
      data.filesCount <= 1000000 &&
      data.clientCreatedAt is string &&
      data.clientCreatedAt.size() >= 1 &&
      data.clientCreatedAt.size() <= 64 &&
      data.createdAt is timestamp &&
      data.lastSeenAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
      isValidId(data.uid) &&
      data.uid == userId &&
      data.displayName is string &&
      data.displayName.size() <= 150 &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 150 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdmin(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
      isValidId(data.uid) &&
      data.uid == adminId &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 150 &&
      data.role is string &&
      data.role.size() <= 20 &&
      data.role == 'admin' &&
      data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /subscriptions/{subscriptionId} {
      allow get: if isVerifiedSignedIn() &&
        isValidId(subscriptionId) &&
        (isAdmin() || existing().ownerUid == request.auth.uid);

      allow list: if isVerifiedSignedIn() &&
        (isBootstrapAdmin() || resource.data.ownerUid == request.auth.uid);

      allow create: if isVerifiedSignedIn() &&
        isValidId(subscriptionId) &&
        isValidSubscription(incoming(), subscriptionId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().lastSeenAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().ownerUid == request.auth.uid &&
            incoming().status == 'active' &&
            incoming().adminMessage == '' &&
            incoming().adminMessageUpdatedAt == ''
          )
        );

      allow update: if isVerifiedSignedIn() &&
        isValidId(subscriptionId) &&
        isValidSubscription(incoming(), subscriptionId) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().clientCreatedAt == existing().clientCreatedAt &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName',
              'status',
              'adminMessage',
              'adminMessageUpdatedAt',
              'filesCount',
              'lastSeenAt',
              'updatedAt'
            ])
          ) ||
          (
            isDocOwner(existing().ownerUid) &&
            incoming().status == existing().status &&
            incoming().adminMessage == existing().adminMessage &&
            incoming().adminMessageUpdatedAt == existing().adminMessageUpdatedAt &&
            incoming().lastSeenAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName',
              'filesCount',
              'lastSeenAt',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedSignedIn() &&
        isValidId(subscriptionId) &&
        isAdmin();
    }

    match /users/{userId} {
      allow get: if isVerifiedSignedIn() &&
        isValidId(userId) &&
        (isOwner(userId) || isAdmin());

      allow list: if isVerifiedSignedIn() &&
        (isBootstrapAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isVerifiedSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'updatedAt'
        ]);

      allow delete: if isVerifiedSignedIn() &&
        isValidId(userId) &&
        isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isVerifiedSignedIn() &&
        isValidId(adminId) &&
        (isOwner(adminId) || isAdmin());

      allow list: if isVerifiedSignedIn() &&
        (isBootstrapAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isVerifiedSignedIn() &&
        isValidId(adminId) &&
        isValidAdmin(incoming(), adminId) &&
        isBootstrapAdmin() &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedSignedIn() &&
        isValidId(adminId) &&
        isBootstrapAdmin();
    }
  }
}
